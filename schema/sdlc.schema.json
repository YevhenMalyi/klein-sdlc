{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YevhenMalyi/klein-sdlc/schema/sdlc.schema.json",
  "title": "klein-sdlc project manifest",
  "description": "Every project-specific name the klein-sdlc skills use, once. Lives at .claude/sdlc.json in the host repo; skills inject it at load time and name a value by its path.",
  "type": "object",
  "required": [
    "tracker",
    "forge",
    "gates",
    "commits",
    "docs",
    "review"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "tracker": {
      "type": "object",
      "required": [
        "kind",
        "team",
        "project",
        "issuePrefix",
        "states",
        "typeLabels",
        "areaLabelPrefix"
      ],
      "properties": {
        "kind": {
          "const": "linear",
          "description": "Only Linear is implemented today."
        },
        "team": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "description": "The open build project the board skills read."
        },
        "issuePrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*$"
        },
        "states": {
          "type": "object",
          "required": [
            "backlog",
            "todo",
            "inProgress",
            "inReview",
            "done"
          ],
          "properties": {
            "backlog": {
              "type": "string"
            },
            "todo": {
              "type": "string"
            },
            "inProgress": {
              "type": "string"
            },
            "inReview": {
              "type": "string"
            },
            "done": {
              "type": "string"
            }
          }
        },
        "typeLabels": {
          "type": "object",
          "required": [
            "story",
            "task",
            "bug",
            "chore",
            "spike"
          ],
          "properties": {
            "story": {
              "type": "string"
            },
            "task": {
              "type": "string"
            },
            "bug": {
              "type": "string"
            },
            "chore": {
              "type": "string"
            },
            "spike": {
              "type": "string"
            }
          }
        },
        "areaLabelPrefix": {
          "type": "string"
        },
        "deferLabel": {
          "type": "string"
        }
      }
    },
    "forge": {
      "type": "object",
      "required": [
        "kind",
        "owner",
        "repo",
        "baseBranch",
        "issueBranch",
        "noIssueBranch",
        "noIssueTag",
        "pushVia",
        "scopeLabels"
      ],
      "properties": {
        "kind": {
          "const": "github"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string"
        },
        "issueBranch": {
          "type": "string",
          "description": "Pattern with <n> and <kebab-description> placeholders."
        },
        "noIssueBranch": {
          "type": "string"
        },
        "noIssueTag": {
          "type": "string"
        },
        "pushVia": {
          "enum": [
            "local-git",
            "mcp"
          ]
        },
        "pushViaNote": {
          "type": "string"
        },
        "scopeLabels": {
          "type": "object",
          "description": "PR label -> path prefixes that earn it.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Verification commands, run in order, each to completion, before any commit."
    },
    "gatesNote": {
      "type": "string"
    },
    "commits": {
      "type": "object",
      "required": [
        "scopes"
      ],
      "properties": {
        "scopes": {
          "type": "object",
          "description": "Conventional-commit scope -> what it covers.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "docs": {
      "type": "object",
      "required": [
        "rules",
        "practices",
        "reviewCatalogues"
      ],
      "properties": {
        "permissions": {
          "type": "string"
        },
        "structure": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        },
        "practices": {
          "type": "string"
        },
        "reviewCatalogues": {
          "type": "string",
          "description": "Directory holding one catalogue per review lane; review.lanes[].catalogue is a file name inside it."
        },
        "qa": {
          "type": "string",
          "description": "The QA catalogue manual-qa-engineer reads first: apps, ports, sign-in per role, blocked-not-defect failures, seeded data. Shape: templates/qa-catalogue.md."
        },
        "uxHouseRules": {
          "type": "string",
          "description": "Part 2 of the UX standard: the product's audiences and the rules that take sides for each. Shape: templates/ux-house-rules.md."
        },
        "specTemplate": {
          "type": "string",
          "description": "The host's own spec template, when the plugin's does not fit. Omitted, write-spec uses templates/spec-template.md from the plugin. Shape: that file."
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "lanes"
      ],
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "description": "The review lanes, in the order full-review spawns and reports them. Put the lanes whose findings are things that are broken (reachability, wrongness) ahead of the conformance ones.",
          "items": {
            "type": "object",
            "required": [
              "agent",
              "catalogue",
              "trigger"
            ],
            "additionalProperties": false,
            "properties": {
              "agent": {
                "type": "string",
                "minLength": 1,
                "description": "The subagent to spawn, exactly as the Agent tool names it: a bare name for an agent in the host's .claude/agents/, or plugin-qualified such as klein-sdlc:basic-reviewer."
              },
              "catalogue": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+\\.md$",
                "description": "The lane's catalogue, a file name under docs.reviewCatalogues."
              },
              "trigger": {
                "description": "\"always\": runs on any diff. \"catalogue\": runs when a changed path matches the trigger list the catalogue carries under § Trigger paths. A list: runs when a changed path starts with one of these prefixes.",
                "oneOf": [
                  {
                    "const": "always"
                  },
                  {
                    "const": "catalogue"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "optionalCatalogue": {
                "type": "boolean",
                "description": "true: spawn the lane even when its catalogue is missing; its agent file says how it degrades. Default false: a lane with no catalogue is skipped and named in the report's opening line."
              }
            }
          }
        }
      }
    }
  }
}
